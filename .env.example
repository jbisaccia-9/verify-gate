# Names only. Copy to .env (git-ignored) and fill in locally. Nothing here is required:
# with none of these set, the template drafter runs and `send` writes an .eml instead of mailing.

# Optional: draft the letter prose with Claude instead of the template.
ANTHROPIC_API_KEY=
VERIFYGATE_MODEL=claude-sonnet-4-5

# Optional: persist the seeded warehouse instead of rebuilding it in memory each run.
VERIFYGATE_DB=

# Optional: actually send. Absent SMTP_HOST, `send` is always a dry run.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
